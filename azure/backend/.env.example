# Injected via Container Apps env/secrets in production
DB_HOST=vms-pg.postgres.database.azure.com
DB_USER=vmsadmin
DB_NAME=vmsdb
DB_PASSWORD=<from key vault>
KEY_VAULT_URI=https://vms-kv.vault.azure.net/
TENANT_NAME=vmsuniversity
TENANT_ID=xxxx
API_CLIENT_ID=xxxx   # the backend's own API app registration ID, not either SPA's client ID
STORAGE_CONNECTION_STRING=<from key vault>
STORAGE_CONTAINER=avatars
ACS_CONNECTION_STRING=<from key vault>
ACS_SENDER=DoNotReply@<domain>.azurecomm.net
ALLOWED_ORIGINS=https://<your-static-web-app>.azurestaticapps.net
